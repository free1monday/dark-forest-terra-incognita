# PostgreSQL connection string (local Docker or Vercel Postgres / Neon / Supabase)
# Local example (docker compose db service):
#   postgresql://df:df@127.0.0.1:5432/darkforest?schema=public
# Vercel Postgres / Neon typically:
#   postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL="postgresql://df:df@127.0.0.1:5432/darkforest?schema=public"

JWT_SECRET="change-me-local-use-long-random-in-prod"
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Production admin API (header X-Admin-Secret)
ADMIN_SECRET=

# Optional rate limit
# RATE_LIMIT_MAX=200
