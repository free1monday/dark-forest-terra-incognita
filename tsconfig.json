{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["./shared/src/index.ts"],
      "@shared/*": ["./shared/src/*"]
    }
  },
  "include": ["api/**/*.ts", "server/src/**/*.ts", "shared/src/**/*.ts"]
}
